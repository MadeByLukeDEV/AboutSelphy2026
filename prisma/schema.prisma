// Single physical schema for the whole app, organized into commented
// sections per module (see src/modules/README.md). Lives in its own
// Postgres schema (DATABASE_SCHEMA, default "main") on the shared
// AboutSelphy instance -- the central auth service's tables sit next to it
// in "auth" and are never touched from here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── profile ─────────────────────────────────────────────────────────────
// Who AboutSelphy is: the public home/about content. Long-form text is
// stored per locale (de/en) and edited in /admin; it is plain text
// (paragraphs separated by blank lines), never rendered as HTML.

/// Singleton row (id is always 1).
model Profile {
  id          Int      @id @default(1)
  displayName String   @db.VarChar(80)
  taglineDe   String   @db.VarChar(200)
  taglineEn   String   @db.VarChar(200)
  bioDe       String   @db.Text
  bioEn       String   @db.Text
  updatedAt   DateTime @updatedAt
}

enum GameStatus {
  main // what most streams are about
  regular // played often
  occasional // played now and then
  new // recently started
  planned // coming soon, not streamed yet
  former // no longer played, kept for context
}

/// A game AboutSelphy plays (or played), shown on the home page.
model Game {
  id             String     @id @default(cuid())
  slug           String     @unique @db.VarChar(60)
  name           String     @db.VarChar(80)
  status         GameStatus
  sortOrder      Int        @default(0)
  /// Listed under "What I play" on the home page. Hidden games stay
  /// available for the schedule and admin.
  showOnHome     Boolean    @default(true)
  blurbDe        String     @db.VarChar(400)
  blurbEn        String     @db.VarChar(400)
  /// Short labels (mostly proper nouns like "Hourglass PvP"), not translated.
  tags           String[]
  /// Twitch category name to look up when it differs from `name`
  /// (e.g. "Hunt: Showdown 1896"). Empty = use `name`.
  twitchCategory String     @default("") @db.VarChar(80)
  /// Resolved Twitch category id and 285x380 box art (static-cdn.jtvnw.net),
  /// filled on save and by the sync if missing. null = no cover found.
  twitchGameId   String?    @db.VarChar(20)
  boxArtUrl      String?    @db.VarChar(300)
  /// Uploaded cover (Asset). Takes priority over the Twitch box art.
  customCoverId  String?    @unique
  customCover    Asset?     @relation(fields: [customCoverId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  scheduleSlots      ScheduleSlot[]
  scheduleExceptions ScheduleException[]

  @@index([status, sortOrder])
}

// ─── stats ───────────────────────────────────────────────────────────────
// Numbers for the media kit and the live badge, written only by the sync
// job (/api/cron/stats, every 5 minutes). Never entered by hand.

enum StatPlatform {
  twitch
  youtube
}

/// A point-in-time value of one metric (e.g. twitch/followers). The media kit
/// shows the latest per metric with its capturedAt as the "as of" date;
/// older rows give growth over time.
model StatSnapshot {
  id         BigInt       @id @default(autoincrement())
  platform   StatPlatform
  metric     String       @db.VarChar(40)
  value      Float
  capturedAt DateTime     @default(now())

  @@index([platform, metric, capturedAt])
}

/// One Twitch broadcast, built from viewer_count samples taken while live
/// (Twitch has no API for average/peak viewers). Running aggregates instead
/// of raw samples: average = viewerSum / sampleCount.
model StreamSession {
  /// Twitch's stream id.
  id          String   @id @db.VarChar(40)
  startedAt   DateTime
  /// Time of the latest sample. A session seen in the last ~11 minutes is
  /// live; otherwise this is (roughly) when it ended.
  lastSeenAt  DateTime
  title       String   @db.VarChar(200)
  gameName    String   @db.VarChar(120)
  peakViewers Int
  viewerSum   BigInt
  sampleCount Int

  @@index([lastSeenAt])
}

/// One run of the sync job, for the /admin/stats status view.
/// The channel owner's YouTube Analytics authorization (singleton, id = 1),
/// made once with "Connect YouTube" in /admin/stats. Scope
/// yt-analytics.readonly only. The refresh token is AES-256-GCM encrypted
/// (TOKEN_ENCRYPTION_KEY) and never leaves the server.
model YoutubeConnection {
  id                    Int      @id @default(1)
  /// The channel the token was verified against (YOUTUBE_CHANNEL_ID at connect time).
  channelId             String   @db.VarChar(30)
  encryptedRefreshToken String   @db.VarChar(2000)
  /// Name of the admin who connected it (from the auth session).
  connectedBy           String   @db.VarChar(100)
  connectedAt           DateTime @default(now())
  /// Admin switch: show the demographics section in the public media kit.
  showInMediaKit        Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

enum AudienceDimension {
  age
  gender
  country
  device
}

/// One share of the YouTube audience over a period, e.g. age/"25-34" = 31.2
/// (percent of views). Written by the daily sync as a set per dimension; the
/// media kit shows the latest set.
model AudienceSnapshot {
  id          BigInt            @id @default(autoincrement())
  dimension   AudienceDimension
  /// Age group ("25-34"), gender ("female"), ISO country ("AT", "other") or device ("MOBILE").
  key         String            @db.VarChar(40)
  /// Percent, 0-100.
  share       Float
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  capturedAt  DateTime

  @@index([dimension, capturedAt])
}

model SyncRun {
  id         BigInt    @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  /// Short human-readable summary or error (no secrets, no stack traces).
  summary    String    @db.VarChar(1000)
  trigger    String    @db.VarChar(20)

  @@index([startedAt])
}

/// The latest videos for the Streams page, refreshed hourly by the sync job
/// (a page never waits on Twitch/YouTube). Items that disappear upstream --
/// e.g. expired VODs -- are removed on the next successful sync of their kind.
enum MediaKind {
  twitch_vod
  twitch_clip
  youtube_video
  youtube_short
}

model MediaItem {
  id              String    @id @default(cuid())
  kind            MediaKind
  externalId      String    @db.VarChar(80)
  title           String    @db.VarChar(200)
  url             String    @db.VarChar(300)
  thumbnailUrl    String    @db.VarChar(500)
  publishedAt     DateTime
  durationSeconds Int
  views           Int
  syncedAt        DateTime  @updatedAt

  @@unique([kind, externalId])
  @@index([kind, publishedAt])
}

// ─── schedule ────────────────────────────────────────────────────────────
// The weekly stream plan. Times are wall-clock times in Europe/Vienna (DST
// aware when turned into instants); dates are Vienna calendar dates.

/// A stream that repeats every week.
model ScheduleSlot {
  id                 String           @id @default(cuid())
  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday            Int              @db.SmallInt
  /// "HH:mm", Europe/Vienna.
  startTime          String           @db.VarChar(5)
  durationMinutes    Int              @db.SmallInt
  gameId             String?
  game               Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  titleEn            String           @default("") @db.VarChar(120)
  titleDe            String           @default("") @db.VarChar(120)
  active             Boolean          @default(true)
  /// A Twitch category picked by search instead of a Game (never both;
  /// CHECK in the migration). Lets the schedule use games that aren't in
  /// the Games section.
  twitchCategoryId   String?          @db.VarChar(20)
  twitchCategoryName String?          @db.VarChar(120)
  twitchBoxArtUrl    String?          @db.VarChar(300)
  categories         StreamCategory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  exceptions ScheduleException[]

  @@index([weekday])
}

enum ScheduleExceptionKind {
  cancelled // one occurrence of a slot doesn't happen
  extra // a one-off stream on a date
}

/// A change to the weekly plan on one date. Moving a stream = cancel + extra.
model ScheduleException {
  id                 String                @id @default(cuid())
  kind               ScheduleExceptionKind
  /// Europe/Vienna calendar date.
  date               DateTime              @db.Date
  /// cancelled: the slot whose occurrence is cancelled.
  slotId             String?
  slot               ScheduleSlot?         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// extra: when, how long, what.
  startTime          String?               @db.VarChar(5)
  durationMinutes    Int?                  @db.SmallInt
  gameId             String?
  game               Game?                 @relation(fields: [gameId], references: [id], onDelete: SetNull)
  titleEn            String                @default("") @db.VarChar(120)
  titleDe            String                @default("") @db.VarChar(120)
  /// Optional public note, e.g. why a stream is cancelled.
  noteEn             String                @default("") @db.VarChar(200)
  noteDe             String                @default("") @db.VarChar(200)
  /// extra: cancelled but still listed (struck through) instead of deleted.
  cancelled          Boolean               @default(false)
  /// extra: why it was cancelled, kept apart from the normal note so a
  /// restore brings the original note back.
  cancelReasonEn     String                @default("") @db.VarChar(200)
  cancelReasonDe     String                @default("") @db.VarChar(200)
  /// A Twitch category picked by search instead of a Game (never both;
  /// CHECK in the migration). Lets the schedule use games that aren't in
  /// the Games section.
  twitchCategoryId   String?               @db.VarChar(20)
  twitchCategoryName String?               @db.VarChar(120)
  twitchBoxArtUrl    String?               @db.VarChar(300)
  categories         StreamCategory[]
  createdAt          DateTime              @default(now())

  @@unique([slotId, date])
  @@index([date])
}

/// The Discord channel the schedule is posted to (one webhook, set in
/// /admin/schedule). Singleton (CHECK id = 1). The webhook URL contains its
/// secret token: stored encrypted (token-cipher, TOKEN_ENCRYPTION_KEY) and
/// never sent to the browser.
model DiscordSchedule {
  id             Int       @id @default(1)
  webhookUrlEnc  String
  /// Public parts, for display: the webhook id, name, channel and server.
  webhookId      String    @db.VarChar(30)
  webhookName    String    @default("") @db.VarChar(80)
  channelId      String    @default("") @db.VarChar(30)
  guildId        String    @default("") @db.VarChar(30)
  /// Language of the message and image: "de" or "en".
  locale         String    @default("de") @db.VarChar(2)
  autoUpdate     Boolean   @default(true)
  /// A fresh message every Monday 14:00 (Vienna), pinging pingRoleId.
  weeklyPost     Boolean   @default(false)
  /// Discord role id to ping in the weekly post (e.g. @livestream).
  pingRoleId     String?   @db.VarChar(20)
  /// Monday ("YYYY-MM-DD", Vienna) of the week whose post went out.
  weeklyPostWeek String?   @db.VarChar(10)
  /// The message we keep editing; null until the first post.
  messageId      String?   @db.VarChar(30)
  /// Hash of what was last posted, so unchanged schedules are not re-sent.
  contentHash    String?   @db.VarChar(64)
  lastSyncedAt   DateTime?
  /// Last failure as a short code (never Discord text or the URL).
  lastError      String    @default("") @db.VarChar(40)
  connectedBy    String    @default("") @db.VarChar(120)
  updatedAt      DateTime  @updatedAt
}

/// The broadcaster login that lets the site write the Twitch schedule
/// (scope channel:manage:schedule). Singleton (CHECK id = 1). The refresh
/// token is encrypted (token-cipher) and never leaves the server.
model TwitchScheduleConnection {
  id              Int       @id @default(1)
  refreshTokenEnc String
  /// Verified on connect: must be the channel in TWITCH_BROADCASTER_LOGIN.
  broadcasterId   String    @db.VarChar(20)
  login           String    @db.VarChar(25)
  enabled         Boolean   @default(true)
  /// Language of the segment titles on Twitch: "de" or "en".
  titleLocale     String    @default("de") @db.VarChar(2)
  lastSyncedAt    DateTime?
  /// Last failure as a short code (never Twitch text or tokens).
  lastError       String    @default("") @db.VarChar(40)
  connectedBy     String    @default("") @db.VarChar(120)
  updatedAt       DateTime  @updatedAt
}

/// One stream of the next 14 days as a Twitch schedule segment. Twitch can
/// only cancel the *next* date of a recurring segment, so every occurrence
/// is its own one-off segment, mirrored on a rolling window by the sync.
model TwitchScheduleSegment {
  id            String   @id @default(cuid())
  /// StreamOccurrence.key: slot or one-time stream id + date.
  occurrenceKey String   @unique @db.VarChar(80)
  segmentId     String   @db.VarChar(200)
  /// Hash of what was last sent (start, length, category, title, cancelled).
  contentHash   String   @db.VarChar(64)
  startAt       DateTime
  createdAt     DateTime @default(now())

  @@index([startAt])
}

/// A label for streams, e.g. "Dixper enabled", "Sponsored", "Drops".
/// Managed in /admin/schedule.
model StreamCategory {
  id         String              @id @default(cuid())
  nameEn     String              @db.VarChar(40)
  nameDe     String              @db.VarChar(40)
  color      StreamCategoryColor @default(green)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  slots      ScheduleSlot[]
  exceptions ScheduleException[]
}

/// Fixed palette (each has light/dark styles with AA contrast).
enum StreamCategoryColor {
  green
  blue
  violet
  amber
  rose
  slate
}

// ─── assets ──────────────────────────────────────────────────────────────
// Images uploaded in /admin (game covers now, partner logos later). Stored
// in the DB -- the container has no persistent disk -- after validation and
// re-encoding to WebP (src/modules/assets). Served by /api/media/[id]; an
// asset never changes, a new upload gets a new id.

model Asset {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String   @db.VarChar(40)
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  gameCover   Game?
  partnerLogo Partner?
}

// ─── mediakit ────────────────────────────────────────────────────────────
// Partners and packages shown on /mediakit, edited in /admin/partners.

/// A brand AboutSelphy works (or worked) with, e.g. a referral deal.
model Partner {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(80)
  /// https only (checked by zod). Referral links included.
  url           String   @db.VarChar(300)
  /// Referral or discount code; empty = none.
  code          String   @default("") @db.VarChar(40)
  descriptionEn String   @db.VarChar(300)
  descriptionDe String   @db.VarChar(300)
  logoId        String?  @unique
  logo          Asset?   @relation(fields: [logoId], references: [id], onDelete: SetNull)
  /// Hidden partners can be prepared (e.g. while still testing a product).
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, sortOrder])
}

/// A sponsorship offer ("Dedicated stream", "Sponsored segment", ...).
model Package {
  id            String   @id @default(cuid())
  titleEn       String   @db.VarChar(80)
  titleDe       String   @db.VarChar(80)
  descriptionEn String   @db.VarChar(600)
  descriptionDe String   @db.VarChar(600)
  /// Starting price in whole euros; null = "price on request".
  priceFrom     Int?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, sortOrder])
}

// ─── legal ──────────────────────────────────────────────────────────────
// Impressum (built from the operator fields) and privacy policy (Markdown
// per locale), edited in /admin/legal. Nothing is public until published.

/// Singleton (id = 1, CHECK in the migration).
model LegalSettings {
  id             Int      @id @default(1)
  operatorName   String   @default("") @db.VarChar(120)
  street         String   @default("") @db.VarChar(120)
  postalCode     String   @default("") @db.VarChar(20)
  city           String   @default("") @db.VarChar(80)
  country        String   @default("") @db.VarChar(80)
  email          String   @default("") @db.VarChar(254)
  phone          String   @default("") @db.VarChar(40)
  /// Extra Impressum text (Markdown), e.g. the MedienG "Blattlinie".
  imprintExtraEn String   @default("") @db.VarChar(4000)
  imprintExtraDe String   @default("") @db.VarChar(4000)
  /// Privacy policy (Markdown, no HTML).
  privacyEn      String   @default("") @db.VarChar(30000)
  privacyDe      String   @default("") @db.VarChar(30000)
  published      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// ─── inquiries ───────────────────────────────────────────────────────────
// Sponsor inquiries from the media kit form, managed in /admin/inquiries.
// Personal data (GDPR): only what's needed to answer, no IP address; done
// and spam inquiries are deleted after 12 months (purgeOldInquiries).

enum InquiryStatus {
  new
  in_progress
  done
  spam
}

enum InquiryBudget {
  under_100
  from_100_to_250
  from_250_to_500
  over_500
  product_only
  unsure
}

model Inquiry {
  id          String        @id @default(cuid())
  company     String        @db.VarChar(120)
  contactName String        @db.VarChar(100)
  email       String        @db.VarChar(254)
  budget      InquiryBudget
  message     String        @db.VarChar(3000)
  /// Language the form was sent in (de/en), to answer in it.
  locale      String        @db.VarChar(2)
  status      InquiryStatus @default(new)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}
