# Copy to .env.local (or .env). Both the app and the Prisma CLI read
# .env.local first, then .env.

# Database: the shared AboutSelphy Postgres instance. Keep the URL a plain
# connection string (no ?schema=): the app passes DATABASE_SCHEMA to the pg
# adapter, and prisma7.config.ts appends it for the CLI. URL-encode special
# characters in the password.
DATABASE_URL="postgres://user:password@host:5432/aboutselphy"
DATABASE_SCHEMA="main"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Central staff auth (auth.aboutselphy.com). Sessions are validated by
# reading its Postgres tables directly, so these must match the auth
# service's config. Local dev: the auth service runs on :3000, this app on
# :3002 (`pnpm dev`); add http://localhost:3002 to the auth service's
# TRUSTED_ORIGINS or login/sign-out won't redirect back here.
AUTH_URL="http://localhost:3000"
# The read-only aboutselphy_auth_reader role (SELECT on session + "user").
AUTH_DATABASE_URL="postgres://aboutselphy_auth_reader:password@host:5432/aboutselphy"
AUTH_DATABASE_SCHEMA="auth"
# Same value as the auth service's BETTER_AUTH_SECRET (verifies the cookie).
BETTER_AUTH_SECRET="same-secret-as-the-auth-service"
AUTH_COOKIE_PREFIX="better-auth"

# Stats sync (src/modules/stats) -- optional; without them the sync reports
# "not configured". Same Twitch app + YouTube key as the Social app.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_BROADCASTER_LOGIN="aboutselphy"
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCROyDUHpZmACVVPGyQjgyjw"
# Bearer token for POST /api/cron/stats. Generate plain hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# YouTube Analytics (audience demographics in the media kit), connected once
# by the channel owner in /admin/stats. Own OAuth client ("Web application")
# in the auth service's Google Cloud project, with the YouTube Analytics API
# enabled. Authorized redirect URIs: https://aboutselphy.com/api/youtube/callback
# and http://localhost:3002/api/youtube/callback. The consent screen must be
# "In production", or Google expires the refresh token after 7 days.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Encrypts the stored refresh token (AES-256-GCM). 32 bytes as hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it means connecting again.
TOKEN_ENCRYPTION_KEY=""

# Cloudflare Turnstile (sponsor inquiry form). Site key is public, the
# secret is only used server-side for siteverify. Optional allowlist of the
# hostnames siteverify may report (default: host of NEXT_PUBLIC_SITE_URL);
# never include localhost in production.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_HOSTNAMES=""

# Shared Redis (inquiry rate limit; optional, every use fails soft).
REDIS_URL="redis://user:password@host:6379"

# Discord/Twitch schedule syncs only run in production: dev and production
# share the database (and the webhook + Twitch login), so a dev server would
# post, edit and ping too. "true" allows them locally, for testing on purpose.
SCHEDULE_INTEGRATIONS_IN_DEV="false"
